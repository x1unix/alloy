// Forge demo: receive Cloudflare LogPush via HTTP and forward to debug exporter.
//
// Usage:
//   cd example/forge && bash run-alloy.sh
//
// Test:
//   curl -X POST http://localhost:43210 -d '{"EdgeStartTimestamp":"2026-03-07T12:00:00Z","ClientIP":"1.2.3.4"}'

forge.source.cloudflare "logs" {
  logs {
    endpoint = "localhost:43210"
  }

  output {
    logs = [otelcol.exporter.debug.default.input]
  }
}

otelcol.exporter.debug "default" {}
